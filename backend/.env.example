# Loaded and validated centrally by src/config/environment.ts.
PORT=3000
# Host commands use localhost; Docker Compose supplies hostname postgres.
DATABASE_URL=postgresql://postgres:secret@localhost:5432/techarena

# Supabase Dashboard > select project > Connect > Project URL (HTTPS origin).
# No publishable key is needed by this backend: verification uses public JWKS.
# See docs/AUTHENTICATION.md. Protected routes fail closed while unset.
SUPABASE_URL=
CORS_ORIGINS=http://localhost:4200
