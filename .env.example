# Docker Compose reads .env from the repository root.
# Copy this file to .env before running docker compose up -d.

# PostgreSQL address inside the Compose network (not localhost).
DATABASE_URL=postgresql://postgres:secret@postgres:5432/techarena

# Supabase Dashboard > select project > Connect > Project URL.
# Copy only the HTTPS origin, e.g. https://your-project.supabase.co.
# The backend verifies public JWKS; only the frontend uses the publishable key.
# See backend/docs/AUTHENTICATION.md.
# While unset, health remains available and protected routes fail closed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only; required to provision RLS-protected chat participants.
SUPABASE_SERVICE_ROLE_KEY=

# Frontend API URL as seen by the browser.
VITE_API_BASE_URL=http://localhost:3000

# Allowed browser origins, separated by commas and without trailing slashes.
CORS_ORIGINS=http://localhost:4200
