# Backend-only configuration. Copy to .env.backend for Docker.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:secret@postgres:5432/techarena
SUPABASE_URL=
# Supabase secret key (sb_secret_...) or legacy service_role JWT; never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:4200
